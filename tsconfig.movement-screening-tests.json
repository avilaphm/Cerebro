{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./utils/pt/movement-screening",
    "outDir": "./.movement-screening-test-dist",
    "noEmit": false,
    "incremental": false,
    "allowJs": false
  },
  "include": [
    "utils/pt/movement-screening/contracts.ts",
    "utils/pt/movement-screening/constants.ts",
    "utils/pt/movement-screening/camera-constraints.ts",
    "utils/pt/movement-screening/capture-format.ts",
    "utils/pt/movement-screening/canonical-json.ts",
